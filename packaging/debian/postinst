#!/bin/sh
# Runs after the package is installed or upgraded.
set -e

if [ "$1" = configure ]; then
    systemd-sysusers accordion.conf
    # A first install, or one after a purge: start every time the machine
    # starts. After a remove without a purge, dpkg passes the old version,
    # and the service is still turned on from before.
    if [ -z "$2" ]; then
        systemctl enable accordion.service
    fi
    # Without a running systemd, such as while an image is being built, the
    # service starts on the next boot instead. Otherwise start it now, or
    # restart into the new version, unless the admin turned it off.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if systemctl is-enabled --quiet accordion.service; then
            systemctl restart accordion.service
        fi
    fi
fi
