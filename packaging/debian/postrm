#!/bin/sh
# Runs after the package is removed or purged. The data folder always stays,
# even on purge, because it holds the household's files and nobody can get
# them back once it's gone.
set -e

# The service file is gone by now, so systemctl can't turn the service off.
# Remove the link that turned it on instead.
if [ "$1" = purge ]; then
    rm -f /etc/systemd/system/multi-user.target.wants/accordion.service
    rm -f /etc/systemd/system/multi-user.target.wants/accordion-update.path
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

if [ "$1" = remove ] && [ -d /var/lib/accordion ]; then
    echo "Accordion's data is still in /var/lib/accordion, including everyone's files."
    echo "Installing Accordion again uses it. If you don't need it, and you have a backup,"
    echo "you can delete it with: sudo rm -r /var/lib/accordion"
fi
