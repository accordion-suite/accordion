#!/bin/sh
# Runs before the package is removed or upgraded. An upgrade leaves the
# service running, and the new version's postinst restarts it.
set -e

# Removing stops the service but leaves it turned on, so installing again
# starts it again. Purging turns it off, in postrm.
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop accordion.service || true
fi
